{
  "name": "propromanager-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "(git log -1 --format='Commit in costruzione: %h - %s' || true) && rm -rf dist && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "shoot": "node scripts/shoot.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "archivio:accendi": "node scripts/accendi-archivio.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.132.0"
  }
}
